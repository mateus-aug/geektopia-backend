# Copie para .env (o .env NUNCA vai para o Git). Explicação de cada variável abaixo.

# ---- Banco (Supabase/PostgreSQL) ----
# Conexão do app (pooler, porta 6543) e conexão direta (porta 5432, usada nas migrações do Prisma).
DATABASE_URL=
DIRECT_URL=

# ---- Autenticação ----
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria

# ---- Servidor ----
PORT=3333
NODE_ENV=development
# Endereço(s) do front autorizados a chamar a API pelo navegador (vários separados por vírgula).
URL_FRONTEND=http://localhost:5173

# ---- Mercado Pago ----
MP_ACCESS_TOKEN=
# Endereço PÚBLICO do backend para o Mercado Pago avisar os pagamentos (ex.: túnel do ngrok em desenvolvimento).
URL_WEBHOOK=
# Chave secreta do webhook (painel do Mercado Pago > Webhooks). Quando definida, avisos sem assinatura válida são recusados.
MP_WEBHOOK_SECRET=

# ---- Armazenamento de imagens ----
# local (padrão, só desenvolvimento) ou supabase (produção: bucket público no Supabase Storage).
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# ---- Documentos ----
# true = confere o dígito verificador de CPF/CNPJ (padrão: só em NODE_ENV=production).
VALIDAR_DOCUMENTOS=

# ---- Limites de uso (opcionais; os valores abaixo são os padrões) ----
LIMITE_LOGIN_MAX=10
LIMITE_CADASTRO_MAX=15
LIMITE_UPLOAD_MAX=30
LIMITE_GERAL_MAX=600
